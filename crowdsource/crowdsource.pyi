from typing import Any

class Client:
    def __init__(self, base_url: str, api_key: str | None = None) -> None: ...
    @staticmethod
    def from_env() -> Client: ...
    @staticmethod
    def with_bearer(base_url: str, bearer_token: str) -> Client: ...
    def summary(self) -> Any: ...
    def events(self, limit: int | None = None) -> Any: ...
    def economic_config(self) -> Any: ...
    def me(self) -> Any: ...
    def update_me(self, patch: Any) -> Any: ...
    def credit_balance(self) -> Any: ...
    def profile(self, handle: str) -> Any: ...
    def request_access(self, competition_id: str) -> Any: ...
    def manage_access(self, competition_id: str, handle: str, action: str) -> Any: ...
    def list_access(self, competition_id: str) -> Any: ...
    def gift_credits(self, recipient_handle: str, amount: int, message: str | None = None) -> Any: ...
    def get_org(self, org_id: str) -> Any: ...
    def list_competitions(
        self,
        status: str | None = None,
        competition_type: str | None = None,
        limit: int | None = None,
        offset: int | None = None,
        mine: bool | None = None,
        hosted: bool | None = None,
        tag: str | None = None,
        needs_resolution: bool | None = None,
        sort: str | None = None,
    ) -> Any: ...
    def get_competition(self, id: str) -> Any: ...
    def create_competition(self, req: Any) -> Any: ...
    def publish_competition(self, id: str) -> Any: ...
    def close_competition(self, id: str) -> Any: ...
    def leaderboard(self, id: str) -> Any: ...
    def input_source(self, id: str) -> Any: ...
    def competition_index(self, id: str) -> Any: ...
    def competition_index_template(self, id: str) -> str: ...
    def infer_schema(
        self,
        file: bytes | None = None,
        filename: str | None = None,
        url: str | None = None,
        format: str | None = None,
        auth_header: str | None = None,
    ) -> Any: ...
    def resolution_file(
        self,
        id: str,
        filename: str,
        bytes: bytes,
        index_column: str | None = None,
        target_column: str | None = None,
        format: str | None = None,
    ) -> None: ...
    def submit(self, competition_id: str, body: Any) -> Any: ...
    def list_submissions(self, competition_id: str) -> Any: ...
    def list_my_submissions(self) -> Any: ...
    def retract_submission(self, competition_id: str) -> Any: ...
    def list_api_keys(self) -> Any: ...
    def create_api_key(self, name: str) -> Any: ...
    def delete_api_key(self, id: str) -> None: ...
    def list_data_sources(self) -> Any: ...
    def create_data_source(self, req: Any) -> Any: ...
    def rank_up(self) -> Any: ...
    def rank_down(self) -> Any: ...
    def create_checkout(self, amount_cents: int) -> Any: ...
